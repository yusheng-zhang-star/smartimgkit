# SmartImgKit Cache + Security Headers for Cloudflare Pages
# Scheme: _headers (all caching + security)
# UTF-8 no BOM — do NOT save with Windows Notepad
# https://developers.cloudflare.com/pages/platform/headers/
#
# ⚠️ 铁律：禁止 /* 兜底规则（会导致缓存污染，见 cf-anti-pitfall Pitfall 4）

# ── Sitemaps / robots: short cache + security ──
/sitemap.xml
  Cache-Control: public, max-age=1800
  CDN-Cache-Control: public, max-age=1800
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/robots.txt
  Cache-Control: public, max-age=1800
  CDN-Cache-Control: public, max-age=1800
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# ── ads.txt: short cache + security ──
/ads.txt
  Cache-Control: public, max-age=3600
  CDN-Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# ── 404: no cache ──
/404.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# ── HTML pages: no browser cache, 12h CDN cache + FULL SECURITY HEADERS ──
/*.html
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
