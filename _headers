# SmartImgKit Cache Headers for Cloudflare Pages
# Scheme: _headers (all caching)
# UTF-8 no BOM — do NOT save with Windows Notepad
# https://developers.cloudflare.com/pages/platform/headers/
#
# ⚠️ 铁律：禁止 /* 兜底规则（会导致缓存污染，见 cf-anti-pitfall Pitfall 4）

# ── Sitemaps / robots: short cache ──
/sitemap.xml
  Cache-Control: public, max-age=1800
  CDN-Cache-Control: public, max-age=1800

/robots.txt
  Cache-Control: public, max-age=1800
  CDN-Cache-Control: public, max-age=1800

# ── 404: no cache ──
/404.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

# ── HTML pages: no browser cache, 12h CDN cache ──
/*.html
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

# ── Clean URLs (no .html extension) ──
/tools/*
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

/blog/*
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

/workflows/*
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

# ── Language variants: es / id / pt ──
/es/*
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

/id/*
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

/pt/*
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

# ── French ──
/fr/*
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

# ── Vietnamese ──
/vi/*
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

# ── Arabic ──
/ar/*
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

# ── Homepage (clean URL root) ──
/
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

# ── Clean URL pages (no .html, no path prefix) ──
/about
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

/contact
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

/privacy
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

/terms
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

/cookie-policy
  Cache-Control: public, max-age=0, stale-while-revalidate=3600
  CDN-Cache-Control: public, max-age=43200, stale-while-revalidate=3600

# ── CSS: 7 days ──
/css/*
  Cache-Control: public, max-age=604800, must-revalidate
  CDN-Cache-Control: public, max-age=604800

# ── JS: 7 days, immutable ──
/js/*
  Cache-Control: public, max-age=604800, immutable
  CDN-Cache-Control: public, max-age=604800

# ── Images: 30 days, immutable ──
/images/*
  Cache-Control: public, max-age=2592000, immutable
  CDN-Cache-Control: public, max-age=2592000

# ── Screenshots: 30 days ──
/screenshots/*
  Cache-Control: public, max-age=2592000, immutable
  CDN-Cache-Control: public, max-age=2592000

# ── Root-level images (just in case) ──
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.svg
/*.ico
  Cache-Control: public, max-age=2592000, immutable
  CDN-Cache-Control: public, max-age=2592000

# ── Fonts: 1 year, immutable ──
/*.woff
/*.woff2
/*.ttf
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000

