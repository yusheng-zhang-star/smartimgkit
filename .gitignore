# ===== SmartImgKit .gitignore =====

# Python
__pycache__/
*.pyc
*.pyo

# Node
node_modules/
dist/
*.log

# Dev artifacts (not needed for deployment)
*.ps1
*.bat
*.sh
*.md
*.bak
*.bak2
*.bak3
_backup_*/

# Build system (run locally, don't deploy)
_build.py
_tool_template.html
_tools_data.json
_pre_deploy_check.py

# Check/debug scripts
check*.js
chk*.js
diag.js
verify*.js
vfy*.js
spot-check.js
quick-check.js
final-audit.js
final-vfy.js
full-audit.js
qa-audit.js
extract-*.js
create-*.js
build-*.js
translate-*.js
inject-*.js
merge-*.js
fix-*.js
add-*.js
bump-*.js
count-*.js
part-*.js
inline-style-*.js
scan_*.txt
deploy_*.txt
email_*.txt
nl_*.txt
fix_v3_*.txt
_cf_*.txt
_auto_test_results.json
_check_results.json
_fixed_files_v3.json
_part2_complete.json
*.txt

# Screenshots are needed for og:image and guide screenshots
# DO NOT ignore - they are referenced by HTML pages
# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
.gh_pat
